# Copy to .env (never commit .env). All defaults are SAFE.
PLN_DATABASE_URL=sqlite:///data/pln_agent.db
PLN_TIMEZONE=America/New_York

# --- Global publish gates (BOTH must change, plus per-account authorization, before any live call) ---
PLN_DRY_RUN=true
PLN_PUBLISHING_ENABLED=false
PLN_REQUIRE_APPROVAL=true

# --- Media ---
PLN_MEDIA_INBOX=sample_media/inbox
PLN_RENDER_DIR=data/renders
# Pull-based APIs (Instagram, Facebook file_url, TikTok PULL_FROM_URL) need renders on a public HTTPS URL you control:
PLN_MEDIA_PUBLIC_BASE_URL=
# Optional local ASR hook, e.g. whisper.cpp: PLN_TRANSCRIBE_CMD="whisper-cli -m model.bin -osrt -of {output} {input}"
PLN_TRANSCRIBE_CMD=

# --- Platform API versions (re-verify against current docs before go-live) ---
META_GRAPH_VERSION=v26.0
LINKEDIN_VERSION=202601
IG_GRAPH_HOST=https://graph.facebook.com
TIKTOK_CLIENT_AUDITED=false

# --- Tokens: referenced by NAME from accounts.credential_ref (e.g. env:LINKEDIN_TOKEN_PLN). Leave blank until OAuth is done. ---
LINKEDIN_TOKEN_PLN=
META_PAGE_TOKEN_PLN=
IG_TOKEN_PLN=
IG_TOKEN_CARJITSU=
IG_TOKEN_PUTTTOUR=
TIKTOK_TOKEN_CARJITSU=
X_TOKEN_CARJITSU=

# --- Optional ---
PLN_LLM_PROVIDER=template      # or: anthropic (requires the anthropic SDK + ANTHROPIC_API_KEY)
PLN_DASHBOARD_PASSWORD=        # set to require HTTP Basic auth on the dashboard
SCHEDULER_API_BASE=            # authorized scheduling-provider fallback (not configured)
